{
  "manifest_version": 3,
  "name": "BrainDrop AI — Web Clipper",
  "version": "0.1.0",
  "description": "Clip, tag, and save content from any webpage to BrainDrop AI. On-device AI tagging powered by Gemini Nano 4.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
